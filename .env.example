# Copy to .env and provide secrets locally. Never commit the real .env file.
OPENAI_API_KEY=

# Optional vector database overrides. Local Chroma is used when unset.
VECTOR_DB_MODE=local
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_AUTH_HEADER=Authorization
CHROMA_AUTH_TOKEN=
TRAFFIC_METADATA_INDEX_PATH=

# Model routes are opt-in. Leave disabled until the real key has been rotated.
EAGLE_EYE_ENABLE_MODEL_RESPONSES=false

# Model roles. Deterministic analytics never use these models as a numeric source.
EAGLE_EYE_PLANNER_MODEL=gpt-5.6-terra
EAGLE_EYE_GENERAL_MODEL=gpt-5.6-terra
EAGLE_EYE_RESEARCH_MODEL=gpt-5.6-sol
EAGLE_EYE_REASONING_EFFORT=medium

# Free AISStream WebSocket feed for the live ETA Watch. Create the key at
# https://aisstream.io/ and keep the real value only in the local .env file.
AISSTREAM_API_KEY=
EAGLE_EYE_AISSTREAM_ENABLED=true
EAGLE_EYE_AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
EAGLE_EYE_AISSTREAM_HISTORY_HOURS=24
EAGLE_EYE_AISSTREAM_MAX_AGE_MINUTES=10

# Local structured context, reviewed issue reports, and explicit exports.
EAGLE_EYE_SQLITE_PATH=data/runtime/eagle_eye.sqlite3
EAGLE_EYE_AISSTREAM_SQLITE_PATH=data/runtime/aisstream.sqlite3
EAGLE_EYE_EXPORT_DIR=data/exports
